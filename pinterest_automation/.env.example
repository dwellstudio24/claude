# ── Pinterest ──────────────────────────────────────────────────────────────
# Option A: Paste your access token directly (get from Pinterest Dev portal)
PINTEREST_ACCESS_TOKEN=your_access_token_here

# Option B: Full OAuth (run `python main.py auth` to generate token)
PINTEREST_CLIENT_ID=your_app_id_here
PINTEREST_CLIENT_SECRET=your_app_secret_here

# ── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
